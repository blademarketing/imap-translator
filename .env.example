# Email Configuration - Choose ONE of the following two options:

# Option 1: Single IMAP Account (Legacy - still supported)
#IMAP_SERVER=imap.example.com
#IMAP_PORT=993
#IMAP_EMAIL=your-email@example.com
#IMAP_PASSWORD=your-password-here

# Option 2: Multiple IMAP Accounts (Recommended - supports multiple accounts)
# JSON array format with optional "name" field for easier identification
IMAP_ACCOUNTS=[{"server":"imap.example.com","port":993,"email":"account1@example.com","password":"password1","name":"Personal"},{"server":"imap.gmail.com","port":993,"email":"account2@gmail.com","password":"password2","name":"Work"}]

# Processing Configuration
MAX_EMAILS=50  # Maximum number of recent emails to check per account (default: 50)

# Telegram Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
